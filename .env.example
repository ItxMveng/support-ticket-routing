# Copier en .env (jamais versionné) et compléter.
# LLM (approche few-shot et routage hybride) : clé Groq gratuite
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Traces Langfuse (facultatif) : laisser vide pour désactiver
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
